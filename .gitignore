# 依赖与构建产物
node_modules/
dist/
dist-electron/
release/
out/
out-portable/
# electron-builder 中断后留下的临时构建目录（release26 / release260 …）与 Vite 临时配置
release2*/
vite.config.mjs.timestamp-*

# 运行时数据（本地数据库、封面缓存，不入库）
data/
covers/

# 内部文档（仅本地保留，不公开）
docs/
PROJECT_BRIEF.md
接续工作小结.md
项目总结_*.md

# AI 助手的工作目录（会话记忆 / 内部笔记，仅本地保留）
.workbuddy-ai/
.trae/

# 日志与系统文件
*.log
Thumbs.db
.DS_Store

# 本地临时脚本/中间产物（发布脚本、探针、截图等，仅本地用）
tmp/

# 内置播放内核二进制（约 120MB，不入库；获取方式见 vendor/mpv/README.md）
vendor/mpv/*.exe
vendor/mpv/*.dll
vendor/mpv/*.com
