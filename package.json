{
  "name": "javtube",
  "version": "1.0.0",
  "description": "JavTube - 本地影片管理软件",
  "main": "electron/main/index.js",
  "author": "JavTube",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win --x64",
    "dist:portable": "node scripts/build-portable.js",
    "preview": "vite preview",
    "start": "electron .",
    "check:undefined": "node scripts/check-undefined.js",
    "scrape:test": "node scripts/scrape-smoke.js"
  },
  "dependencies": {
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "sql.js": "^1.10.3",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.0",
    "sass": "^1.77.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "build": {
    "appId": "com.javtube.app",
    "productName": "JavTube",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
